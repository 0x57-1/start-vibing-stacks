# svs-version: 1.3.0
# Generated by start-vibing-stacks — copy to local.toml (gitignored; machine-specific paths).
# Docs: https://www.kimi.com/code/docs/en/kimi-code-cli/configuration/config-files
#
# Project instructions: root AGENTS.md (and CLAUDE.md for deeper Claude parity).
# MCP: .kimi-code/mcp.json (merged from ~/.claude.json + project .claude/).
# Memories: .kimi-code/skills/svs-memory-index points at .claude/memories/ (same index as Grok).

# Plan-then-act (like Claude defaultMode: plan). Tools/MCP use yolo (like Claude Launch
# --dangerously-skip-permissions) so MCP calls are not approved one-by-one.
default_plan_mode = true
default_permission_mode = "yolo"
merge_all_available_skills = true

# Absolute paths filled by migrate into local.toml (SVS:KIMI block):
# extra_skill_dirs = ["/ABS/PATH/TO/PROJECT/.claude/skills"]
# extra_agent_dirs = ["/ABS/PATH/TO/PROJECT/.claude/agents"]
#
# Hooks: SVS:HOOKS block (migrate) + ~/.kimi-code/config.toml — bridge to
# .claude/hooks/*.ts via node .claude/hooks/svs-bridge.mjs kimi <hook>
#
# Session override without editing this file:
#   kimi --yolo          # tools/MCP auto-approve
#   kimi --auto          # fully autonomous (also skips AskUserQuestion)
#   /yolo                # toggle inside session

[thinking]
enabled = true
effort = "high"
